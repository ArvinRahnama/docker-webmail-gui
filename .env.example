# Docker Webmail GUI — example environment configuration
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored;
# NEVER commit real secrets. Every value below is a placeholder.
#
# Secrets (COOKIE_SECRET, BROKER_SHARED_SECRET) should be generated with a
# CSPRNG, e.g.: `openssl rand -hex 32`. The installer (installer/install.sh,
# milestone M13) generates and writes these for you; set them by hand only
# for local development.
#
# See ARCHITECTURE.md for what each of these controls, and SECURITY.md for
# why (§4.2 headers, §4.4 installer, Part 3 threats).

# ---------------------------------------------------------------------------
# Application mode
# ---------------------------------------------------------------------------

# Required. One of: development | production.
# In "development", the server binds the FAKE drivers by default — no
# Docker daemon or docker-mailserver container is needed to develop against
# (ARCHITECTURE.md §9). Connecting a development instance to a real Docker
# daemon requires a separate, explicit opt-in — see DANGEROUSLY_USE_REAL_DOCKER
# below. In "production", real drivers are used unconditionally.
# Default: development
APP_MODE=development

# Optional, development only. Set to "true" to let a development instance
# talk to a real Docker daemon/broker instead of the fake drivers. Loud and
# explicit on purpose: a developer should never accidentally restart their
# own containers (ARCHITECTURE.md §9). Ignored when APP_MODE=production
# (production always uses real drivers).
# Default: false
DANGEROUSLY_USE_REAL_DOCKER=false

# ---------------------------------------------------------------------------
# apps/server — web tier
# ---------------------------------------------------------------------------

# Optional. TCP port the server listens on (serves both the API and the
# built SPA — ARCHITECTURE.md §4).
# Default: 3000
PORT=3000

# Optional. Bind address for the server's HTTP listener.
# Default: 0.0.0.0
HOST=0.0.0.0

# Optional. Pino log level: fatal | error | warn | info | debug | trace.
# Secrets are redacted at this layer regardless of level (SECURITY.md §3.10)
# — this only controls verbosity, never what is safe to log.
# Default: info
LOG_LEVEL=info

# Required in production (a random value is fine in development, but every
# restart will invalidate existing sessions if it changes). Signs the
# session cookie. Only the session token's *hash* is stored server-side —
# see ARCHITECTURE.md §7.4 — but the cookie itself is still signed against
# tampering. Generate with: openssl rand -hex 32
# Default: none — must be set
COOKIE_SECRET=replace-with-a-64-char-hex-secret-generated-locally

# Optional. Whether the session cookie carries the `Secure` attribute
# (ARCHITECTURE.md §7.4). Defaults on. Turn off only for a plain-HTTP LAN
# install, where forcing it would silently stop the browser from ever
# sending the cookie back — locking an admin out rather than protecting
# them (SECURITY.md §4.2 makes the same allowance for ENABLE_HSTS).
# Default: true
COOKIE_SECURE=true

# Optional. Absolute session lifetime in hours, regardless of activity
# (ARCHITECTURE.md §7.4).
# Default: 12
SESSION_ABSOLUTE_TTL_HOURS=12

# Optional. Idle session lifetime in hours — a session expires this long
# after its last use, even inside the absolute window above.
# Default: 2
SESSION_IDLE_TTL_HOURS=2

# Optional. Directory for the server's own SQLite database (admins,
# sessions, audit log, jobs, metrics — ARCHITECTURE.md §7.3). Distinct from
# BACKUP_DIR and never touched by a mail-data restore.
# Default: ./data
DATA_DIR=./data

# ---------------------------------------------------------------------------
# First-administrator bootstrap
# ---------------------------------------------------------------------------

# Optional, but required together (set both or neither). No default admin
# password ever ships: when no administrator account exists yet, the server
# creates exactly one from this email/password at startup, flagged so the
# password must be changed before any other route is usable. If no
# administrator exists AND this is not set, the server logs a clear,
# actionable message and refuses to serve authenticated routes rather than
# auto-creating a known account (SECURITY.md — no default credentials).
# Recommended: unset these again after the first successful login.
# Default: none
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional. Directory backup archives are written to and read from
# (IMPLEMENTATION_PLAN.md §2.1). Should be a persistent volume outside the
# container's writable layer in production.
# Default: ./backups
BACKUP_DIR=./backups

# ---------------------------------------------------------------------------
# apps/broker — privileged tier
# ---------------------------------------------------------------------------

# Required. Base URL of the broker, reachable only over the internal-only
# Docker network (ARCHITECTURE.md §6). Never expose this network to the
# internet.
# Default: http://broker:4000
BROKER_URL=http://broker:4000

# Required. Shared secret sent as a header on every server -> broker
# request and compared in constant time (ARCHITECTURE.md §6). Must match
# the same value configured on the broker. Rotatable. Generate with:
# openssl rand -hex 32
# Default: none — must be set
BROKER_SHARED_SECRET=replace-with-a-64-char-hex-secret-generated-locally

# Optional. TCP port the broker listens on, inside the internal-only
# broker network.
# Default: 4000
BROKER_PORT=4000

# Optional. Path to the Docker Engine socket, mounted read/write into the
# broker container only — never into apps/server (ARCHITECTURE.md §2, §10).
# Default: /var/run/docker.sock
DOCKER_SOCKET_PATH=/var/run/docker.sock

# ---------------------------------------------------------------------------
# docker-mailserver target
# ---------------------------------------------------------------------------

# Required (one of DMS_CONTAINER_NAME or DMS_CONTAINER_LABEL must resolve
# to exactly one container). The broker resolves the mail container's
# identity itself, at request time, from this configuration — the web tier
# never sends a container ID (ARCHITECTURE.md §6, SECURITY.md §3.1).
# Default: mailserver
DMS_CONTAINER_NAME=mailserver

# Optional. Alternative/additional way to identify the managed mail
# container, as a Docker label selector, e.g. "com.docker-webmail-gui.role=mail".
# Default: none
DMS_CONTAINER_LABEL=

# ---------------------------------------------------------------------------
# Rspamd controller (spam filtering — FEATURE_MATRIX.md §13)
# ---------------------------------------------------------------------------

# Optional. Base URL of the Rspamd controller HTTP API. Only used if the
# deployment has ENABLE_RSPAMD=1 set on the mail container; capability
# detection (ARCHITECTURE.md §5.1) reports it Unsupported otherwise.
# Default: http://mailserver:11334
RSPAMD_URL=http://mailserver:11334

# Optional but recommended. Password for the Rspamd controller's `Password`
# header. Held server-side only and never proxied to the browser
# (FEATURE_MATRIX.md §13). Leave blank only if the controller has no
# password configured.
# Default: none
RSPAMD_PASSWORD=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------

# Optional. Enables the restricted diagnostic command console
# (FEATURE_MATRIX.md §32). Off by default: exec into the mail container is
# root inside a container holding the mail store, DKIM private keys and TLS
# certificates. When enabled, it is still a fixed allowlist of named
# commands, never a free-form shell (SECURITY.md §3.13).
# Default: false
ENABLE_EXEC_CONSOLE=false

# ---------------------------------------------------------------------------
# Transport security
# ---------------------------------------------------------------------------

# Optional. Sends Strict-Transport-Security on responses. Defaults on, but
# can be turned off for a plain-HTTP LAN install, where forcing HTTPS would
# lock an administrator out rather than protect them (SECURITY.md §4.2).
# Leave enabled whenever the deployment is reachable over anything other
# than a trusted local network.
# Default: true
ENABLE_HSTS=true
