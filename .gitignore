# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
out/
*.tsbuildinfo

# Test / coverage — the Playwright artifact directories are anchored to the
# repository root (see the "Application runtime state" comment below for
# why an unanchored rule here is a real risk, not a theoretical one): all
# three are created by `playwright test` (playwright.config.ts) directly
# under the repo root, and an unanchored rule would equally match a
# same-named directory nested anywhere under apps/ or packages/.
coverage/
.nyc_output/
/test-results/
/playwright-report/
/blob-report/
.playwright/

# Environment and secrets — never commit real values
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/

# Application runtime state — anchored to the repository root with a leading
# slash. These are the runtime directories DATA_DIR/BACKUP_DIR default to
# (`./data`, `./backups`); unanchored, `backups/` also matched the source
# directory `apps/server/src/modules/backups/` and silently excluded the
# entire backup/restore module from version control.
/data/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
/backups/

# Playwright's saved sign-in state (e2e/global-setup.ts writes this fresh on
# every run) — a live, if synthetic and throwaway, session cookie.
/e2e/.auth/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
# Local agent tooling — permission grants, machine-specific absolute paths
# and agent definitions. None of it is project source, and it is per-machine
# rather than shared, so the whole directory stays out of the repository.
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Caches
.cache/
.temp/
.tmp/
.eslintcache
.vite/

# Generated knowledge graph (regenerable via the graphify skill; ~4MB)
graphify-out/
