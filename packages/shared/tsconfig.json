{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // Consumed directly by Node (server, broker) — not bundled — so
    // resolution follows Node's own ESM algorithm rather than a bundler's
    // relaxed one. See tsconfig.base.json's comment on this split.
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": ["src"]
}
